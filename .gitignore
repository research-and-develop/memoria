node_modules/
.next/
# Written by `next dev`/`next build`/`next typegen` (its imports differ between
# dev and build). `npm run ts-check:web` regenerates it first.
next-env.d.ts
coverage/
*.tsbuildinfo
*.log

# Cloudflare: OpenNext build output, wrangler's local state (the local D1
# database lives here) and local secrets. Commit .dev.vars.example, never
# .dev.vars.
.open-next/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
# This project's Cloudflare account token (scripts/cloudflare.ts); never an .env* name: OpenNext bundles those.
.cloudflare.env
# Database exports hold client data (docs/deployment.md → Backups): never committed.
/apps/web/*.sql
/apps/web/*.sql.gz*
/d1.sql*
# A migration rehearsal's scratch D1 (docs/deployment.md → Migrations run before the code)
/.rehearsal/

# The relay's dry-run bundle (npm run build:relay).
apps/relay/dist/

# Scratch space for one-off investigations. Durable plans/audits go in docs/.
**/tmp/

.DS_Store

# Browser-automation screenshots and logs (Playwright MCP)
.playwright-mcp/
